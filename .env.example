# 复制为 .env（勿提交真实生产值）
DB_USERNAME=root
DB_PASSWORD=changeme
MYSQL_DATABASE=notemind
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=notemind_vector
PG_USERNAME=postgres
PG_PASSWORD=changeme

JWT_SECRET=please-change-me-to-a-long-random-secret
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Java
GATEWAY_PORT=8080
SERVICE_PORT=8081

# Python AI Engine
AI_ENGINE_URL=http://127.0.0.1:8000
AI_ENGINE_TOKEN=changeme-ai-engine-token
BACKEND_PORT=8000
EMBEDDING_DIMENSION=1024
# 默认知识库 / 检索温度等（可覆盖代码默认）
DEFAULT_KNOWLEDGE_BASE_ID=kb_default
DEFAULT_TOP_K=5
MAX_TOP_K=50
DEFAULT_CHAT_TEMPERATURE=0.3
JUDGE_TEMPERATURE=0
# CORS 逗号分隔；AI 引擎本机联调
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5173,http://localhost:5173

# 业务默认种子 ID（Java application.yml / notemind.defaults 同步）
NOTEMIND_DEFAULT_KB_ID=kb_default
NOTEMIND_DEFAULT_EMBED_MODEL_ID=m_emb_v4
NOTEMIND_DEFAULT_CHUNK_STRATEGY_ID=cs_recursive
NOTEMIND_DEFAULT_RETRIEVAL_STRATEGY_ID=rs_baseline_vector
NOTEMIND_MAX_PAGE_SIZE=100

# 百炼（管理端也可配置，改完热更新）
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_API_KEY=
DASHSCOPE_EMBEDDING_API_KEY=
DASHSCOPE_RERANK_API_KEY=
DEFAULT_CHAT_MODEL=qwen-plus
DEFAULT_EMBEDDING_MODEL=text-embedding-v4
DEFAULT_RERANK_MODEL=gte-rerank-v2

DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=changeme
DEMO_USERNAME=demo
DEMO_PASSWORD=changeme
NOTEMIND_ALLOW_WEAK_DEFAULTS=true
